SESSION_SECRET=local-dev-session-secret-change-me
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin
BOOTSTRAP_ADMIN_FULLNAME=Local Admin
# PostgreSQL: поднимите `docker compose up -d db`, затем локальный uvicorn подключается на localhost
DATABASE_URL=postgresql+psycopg://app:app@127.0.0.1:5432/duty
# Optional CORS origins, comma-separated
CORS_ALLOW_ORIGINS=
