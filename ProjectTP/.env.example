# Скопируйте в `.env` и заполните секреты. Файл `.env` не коммитьте.
# Подстановка для compose: ${VAR:-default} в docker-compose.yml

# Имя проекта для docker compose (префикс контейнеров). Задайте, если каталог с compose
# называется не по-латински или после нормализации имя пустое — иначе ошибка «project name must not be empty».
COMPOSE_PROJECT_NAME=duty

# Эталон времени для дежурств и уведомлений (IANA). Совпадает с расчётом слота в коде (Europe/Moscow); APScheduler :55/:00.
TZ=Europe/Moscow

# Обязательно: сессии FastAPI
SESSION_SECRET=
# true только если пользователи заходят по HTTPS (иначе сессия не сохранится)
SESSION_COOKIE_HTTPS_ONLY=false
# Max-Age cookie сессии (секунды), по умолчанию 14 суток
SESSION_MAX_AGE_SECONDS=1209600 — создаётся администратор (логин нужен для защиты: снять права с этой УЗ нельзя)
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FULLNAME=

# PostgreSQL (сервис db)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=duty
# Порт Postgres на хосте (для доступа с хоста / другого ПК при необходимости)
POSTGRES_PORT=5432

# Порт веб-интерфейса (nginx → приложение). Rootless Podman: используйте >=1024 (например 8080), либо sysctl net.ipv4.ip_unprivileged_port_start=80.
HTTP_PORT=80

# Локальный uvicorn вне Docker: подключение к Postgres на localhost
# Внутри `docker compose up` backend получает DATABASE_URL из compose (хост db), эта строка не используется
DATABASE_URL=postgresql+psycopg://app:app@127.0.0.1:5432/duty

# Опционально
CORS_ALLOW_ORIGINS=
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TIMEOUT_SEC=5
# true — дублировать события уведомлений о дежурствах в n8n (обычно достаточно только Битрикс)
N8N_DUTY_WEBHOOK_ENABLED=false

# Битрикс24 (входящий вебхук + im.message.add): базовый URL …/rest/<user_id>/<token>/ (например https://portal.hpdd.ru/rest/19410/<secret>/)
BITRIX_INCOMING_WEBHOOK_URL=
# Общий чат для дубля «кто заступил»
BITRIX_NOTIFY_DIALOG_ID=441509
BITRIX_WEBHOOK_TIMEOUT_SEC=10

# Срок хранения текста инструкции по публичной ссылке из QR (секунды), по умолчанию 7 суток
EE_INSTRUCTION_SHARE_TTL_SECONDS=604800
